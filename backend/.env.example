# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/alumni_db?schema=public"

# JWT
JWT_SECRET=your-access-token-secret-change-me
JWT_REFRESH_SECRET=your-refresh-token-secret-change-me
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Paystack
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# App
FRONTEND_URL=http://localhost:5173
REGISTRATION_FEE_AMOUNT=1000

# Cloudinary (signed uploads — keep the API secret server-side)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email — Resend (preferred) when RESEND_API_KEY is set (with retry + logging);
# otherwise the nodemailer/SMTP block below is the fallback.
# Test/sandbox mode only delivers to your own account. Send to other recipients
# requires verifying a domain at https://resend.com/domains and setting
# RESEND_FROM to an address on that domain (e.g. alumni@yourdomain.com).
RESEND_API_KEY=re_your-resend-api-key
# RESEND_FROM="Alumni Association <alumni@yourdomain.com>"   # optional; defaults to "Alumni Association" <onboarding@resend.dev>

# Email (SMTP fallback)
SMTP_HOST=smtp.mailersend.net
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
EMAIL_FROM=alumni@yourdomain.com
EMAIL_FROM_NAME=Alumni Association
