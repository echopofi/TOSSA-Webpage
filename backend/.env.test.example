# backend/.env.test.example
# Copy this file to backend/.env.test and fill in the values.
# NEVER commit the real .env.test file.
#
# The test seed (tests/helpers/seed.js) wipes every table in the target database.
# Point this at a disposable/throwaway PostgreSQL instance — never the live DB.

TEST_DATABASE_URL=postgresql://YOUR_TEST_DB_USER:PASSWORD@HOST:5432/tssosa_test
