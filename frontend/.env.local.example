# Frontend environment — copy to .env.local and adjust.
# Backend base URL (Express API). Everything with the NEXT_PUBLIC_ prefix is
# inlined into the client bundle at dev-server start / build time — restart
# `next dev` (or rebuild) after changing it.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Paystack public key for real checkout (optional; mock checkout is used without it)
#NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx